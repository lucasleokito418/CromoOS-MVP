<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 210" fill="none">
  <g stroke="#E5FF00" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round">
    <!-- Head Dome -->
    <path d="M 22 75 C 22 40, 32 25, 50 25 C 68 25, 78 40, 78 75" />

    <!-- Spectacles/Face outline -->
    <path d="M 50 56 C 45 48, 30 48, 25 61 C 19 76, 29 93, 43 93 C 48 93, 50 89, 50 89 C 50 89, 52 93, 57 93 C 71 93, 81 76, 75 61 C 70 48, 55 48, 50 56 Z" />

    <!-- Left Eye Concentric Circles -->
    <circle cx="35" cy="70" r="16" />
    <circle cx="35" cy="70" r="10" />
    <circle cx="35" cy="70" r="5" />
    <circle cx="35" cy="70" r="1" fill="#E5FF00" />

    <!-- Right Eye Concentric Circles -->
    <circle cx="65" cy="70" r="16" />
    <circle cx="65" cy="70" r="10" />
    <circle cx="65" cy="70" r="5" />
    <circle cx="65" cy="70" r="1" fill="#E5FF00" />

    <!-- Beak (Triangle) -->
    <path d="M 45 74 L 55 74 L 50 84 Z" />

    <!-- Left Wing Outer Line -->
    <path d="M 22 78 C 14 90, 8 115, 8 142 C 8 170, 15 188, 30 192" />
    
    <!-- Left Wing Inner/Detail Line -->
    <path d="M 18 102 C 14 120, 14 150, 23 182" />

    <!-- Left Wing Body Separation / Chest Line -->
    <path d="M 22 88 C 28 110, 34 135, 34 165 C 34 180, 31 188, 26 191" />

    <!-- Right Body Outer Line -->
    <path d="M 78 75 C 78 115, 78 150, 78 180 C 78 190, 72 192, 60 192" />

    <!-- Right Body Inner/Chest Line -->
    <path d="M 68 85 C 68 115, 68 150, 68 180 C 68 186, 64 189, 60 189" />

    <!-- Center Chest Line -->
    <line x1="50" y1="94" x2="50" y2="185" />

    <!-- Feet (Loops at bottom) -->
    <path d="M 38 192 C 38 200, 44 200, 44 192" />
    <path d="M 56 192 C 56 200, 62 200, 62 192" />

    <!-- Bottom Center Tail Line/Detail -->
    <line x1="50" y1="185" x2="50" y2="200" />
    <path d="M 44 196 C 47 199, 53 199, 56 196" />
  </g>
</svg>
